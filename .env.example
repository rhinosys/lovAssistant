# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admin_lova"

# Local Ollama Inference (Fablab LAN instance or host)
OLLAMA_BASE_URL="http://192.168.42.138:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct-q4_K_M"

# Application Settings
APP_BASE_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# Sub-path install support (used when packaging behind a reverse proxy under a sub-path, e.g. YunoHost)
NEXT_BASE_PATH=""
NEXT_PUBLIC_BASE_PATH=""
SESSION_SECRET="super-secret-session-key-change-in-production-min-16-chars"
LOG_LEVEL="info"

# YesWiki Integration (MCP Server)
YESWIKI_BASE_URL="https://labovilleurbanne.fr/yeswiki/"
# YESWIKI_COOKIE="PHPSESSID=..."

# Mistral AI Cloud Inference (Optional / Alternative to local Ollama)
MISTRAL_API_KEY="your-mistral-api-key-here"
MISTRAL_MODEL="mistral-small-latest"
MISTRAL_BASE_URL="https://api.mistral.ai/v1"
DEFAULT_LLM_PROVIDER="ollama"


# Encryption key for secrets stored in the database (Framateam password). 32 bytes, base64 or hex.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# Admin area
# Development only: comma-separated usernames granted the admin role (ignored when NODE_ENV=production).
ADMIN_USERS=""
# Set to "true" only behind the YunoHost nginx, which sets X-Lov-Admin on the admin-protected paths.
TRUST_PROXY_ADMIN_HEADER="false"

# Framateam (Mattermost) — fallback when nothing is configured in the admin area
FRAMATEAM_URL="https://framateam.org"
FRAMATEAM_TEAM=""
FRAMATEAM_LOGIN_ID=""
FRAMATEAM_PASSWORD=""
FRAMATEAM_TRIGGER="!lov"
# Only for a dedicated account (e.g. assistant-lov): also answer @mentions.
FRAMATEAM_ACCEPT_MENTIONS="false"
FRAMATEAM_SYNC_INTERVAL_MIN=60
# Optional comma-separated channel names seeding the index/listen flags (CLI-only setups)
FRAMATEAM_INDEX_CHANNELS=""
FRAMATEAM_LISTEN_CHANNELS=""
