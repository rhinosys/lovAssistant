# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admin_lova"

# Local Ollama Inference (Fablab LAN instance or host)
OLLAMA_BASE_URL="http://192.168.42.138:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct-q4_K_M"

# Application Settings
APP_BASE_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# Sub-path install support (used when packaging behind a reverse proxy under a sub-path, e.g. YunoHost)
NEXT_BASE_PATH=""
NEXT_PUBLIC_BASE_PATH=""
SESSION_SECRET="super-secret-session-key-change-in-production-min-16-chars"
LOG_LEVEL="info"

# YesWiki Integration (MCP Server)
YESWIKI_BASE_URL="https://labovilleurbanne.fr/yeswiki/"
# YESWIKI_COOKIE="PHPSESSID=..."

# Mistral AI Cloud Inference (Optional / Alternative to local Ollama)
MISTRAL_API_KEY="your-mistral-api-key-here"
MISTRAL_MODEL="mistral-small-latest"
MISTRAL_BASE_URL="https://api.mistral.ai/v1"
DEFAULT_LLM_PROVIDER="ollama"

